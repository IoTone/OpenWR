# Scout on an M5Camera Model B: plain ESP32 rev 1 with 4 MB SPI PSRAM, console
# on UART0 through the CP2104.

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# PSRAM: the camera frame and the dither buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# The roll: FAT on the flash, long names off (NNNN.BIN like the maplet)
CONFIG_FATFS_LFN_NONE=y
CONFIG_WL_SECTOR_SIZE_4096=y

# The glasses' link: NimBLE NUS peripheral, one connection, no bonding
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2

# esp32-camera's ISR warning (CAM_WARN_THROTTLE) prints a string that lives in
# flash; during a flash write that hangs the ISR and the watchdog resets the
# chip. It is compiled out below LOG level 2, so the compile-time default is
# ERROR; main.c turns the runtime level back up to INFO.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# The LAN frame experiment: Wi-Fi station and esp_http_server with WebSocket.
# Wi-Fi and lwIP buffers go to PSRAM to leave internal RAM for BLE.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Internal RAM: with BLE + Wi-Fi + camera only ~20 KB was left and httpd's
# task failed to start (ESP_ERR_HTTPD_TASK). With SPIRAM_USE_MALLOC the TX
# buffers must be static (~1.6 KB each), so fewer of them; NimBLE to PSRAM.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# TCP: lwIP's default 5760-byte send buffer and window cap a sender at
# 5760 B per round trip. On the glasses (longer RTT) that held frames to
# ~36 KB/s, ~2.9 fps however many requests were in flight. Buffers are in
# PSRAM (TRY_ALLOCATE_WIFI_LWIP).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
