# SR-16 Setlist on a XIAO ESP32-C5 (8 MB flash; dual-band Wi-Fi 6, BLE 5)
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_sr16.csv"

# The XIAO's USB-C is the chip's own USB serial port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_WL_SECTOR_SIZE_4096=y
